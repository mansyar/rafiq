{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rafiq",
  "version": "1.0.0-rc.1",
  "identifier": "com.rafiqcompanion.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rafiq — Muslim Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recitation/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRTUwNzgzMEYyNzM3MUUKUldRZU55Y1Bnd2ZsVVdiYldPRXNHNW8rWWtDcHQwTmNGT1ZhOCtpSlgreWhFZmdkcjBmSXJQTEsK",
      "endpoints": ["https://github.com/mansyar/rafiq/releases/latest/download/latest.json"]
    }
  }
}
