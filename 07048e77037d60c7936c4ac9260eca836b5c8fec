- pub struct MonthlySummary { days_elapsed, complete_days, completion_pct, on_time, qada, missed, on_time_pct, qada_pct, missed_pct }
- pub fn monthly_summary(entries: &[LogEntry], today: NaiveDate) -> MonthlySummary
  Window = 1st of today's month..=today (inclusive); out-of-month/future/unparseable entries ignored.
  complete_days = days with all 5 prayers (status-agnostic); missed = total_slots - logged;
  pct = count * 100.0 / total (multiply-first keeps whole percentages exact in f64).
